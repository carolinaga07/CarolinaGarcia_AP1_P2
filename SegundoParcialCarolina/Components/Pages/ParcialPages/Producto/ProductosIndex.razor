@page "/Productos"
@rendermode InteractiveServer

@inject VentasService ventasService

<PageTitle>Consulta de Productos</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center mb-4">
            <h5 class="card-title">Consulta de Productos</h5>
        </div>

        <div class="card-body">

            <QuickGrid Items="ListaProductos.AsQueryable()" Class="table table-hover">

                <PropertyColumn Property="p => p.ProductoId" Title="ProductoId" Sortable="true" />

                <PropertyColumn Property="p => p.Nombre" Title="Producto" Sortable="true" />

                <PropertyColumn Property="p => p.Precio" Title="Precio" Format="N2" Sortable="true" />

                <PropertyColumn Property="p => p.Stock" Title="Stock" Sortable="true" />

            </QuickGrid>

        </div>

        <div class="card-footer d-flex justify-content-between">
            <label>
                Cantidad de Productos: @ListaProductos.Count()
            </label>

            <label>
                Stock Total: @ListaProductos.Sum(p => p.Stock)
            </label>
        </div>

    </div>
</div>

@code {
    public List<Productos> ListaProductos { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        ListaProductos = await ventasService.ListarProductos();
    }
}
