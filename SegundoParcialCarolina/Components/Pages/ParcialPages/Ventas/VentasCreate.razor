@page "/Ventas/Registro"
@rendermode InteractiveServer
@inject VentasService ventasService
@inject NavigationManager Navigation
@inject ToastService toastService

<PageTitle>Registro de Ventas</PageTitle>
<EditForm Model="venta" OnValidSubmit="Guardar">
    <DataAnnotationsValidator/>
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Registro de Ventas</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="venta.Fecha"/>
                    <ValidationMessage For="() => venta.Fecha"></ValidationMessage>
                </div>
                <div class="mb-3">
                    <label class="form-label">Observacion</label>
                    <InputText class="form-control" @bind-Value="venta.Observacion" />
                </div>

                <ProductoPicker Productos="productos" OnProductoSelected="Agregar"/>
                <QuickGrid Items="venta.Detalles.AsQueryable()" class="table table-hover mt-3">
                    <TemplateColumn Title="Producto" Context="detalle">
                        @productos.FirstOrDefault(p => p.ProductoId == detalle.ProductoId)?.Nombre
                    </TemplateColumn>
                    <PropertyColumn Property="d => d.Cantidad" Title="Cantidad" />
                    <PropertyColumn Property="d => d.Precio" Title="Precio" Format="N2"/>
                    <TemplateColumn Title="SubTotal" Context="detalle">
                        @((detalle.Cantidad * detalle.Precio).ToString("N2"))
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Context="detalle">
                        <button type="button" class="btn btn-outline-danger bi bi-trash" @onclick="() => Quitar(detalle)"></button>
                    </TemplateColumn>
                </QuickGrid>
                <p class="text-end">Total: @venta.Detalles.Sum(d => d.Cantidad * d.Precio).ToString("N2")</p>
            </div>
            <div class="card-footer text-center">
                <a href="/Ventas" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>


@code {
    private Ventas venta { get; set; } = new Ventas();
    private List<Productos> productos = new List<Productos>();

    protected override async Task OnInitializedAsync()
    {
        productos = await ventasService.ListarProductos();
    }  

    private void Agregar((Productos producto, int cantidad) item)
    {
        if (item.cantidad <= 0)
        {
            toastService.ShowError(
                "La cantidad debe ser mayor que cero");
            return;
        }

        var cantidadAgregada = venta.Detalles
            .Where(d => d.ProductoId == item.producto.ProductoId)
            .Sum(d => d.Cantidad);

        if (cantidadAgregada + item.cantidad > item.producto.Stock)
        {
            toastService.ShowError(
                "No hay suficiente stock disponible");
            return;
        }

        venta.Detalles.Add(new VentasDetalle
            {
                ProductoId = item.producto.ProductoId,
                Cantidad = item.cantidad,
                Precio = item.producto.Precio
            });
    }

    private void Quitar(VentasDetalle detalle) => venta.Detalles.Remove(detalle);

    private async Task Guardar()
    {
        if (!venta.Detalles.Any())
        {
            toastService.ShowError(
                "Debe agregar al menos un producto");
            return;
        }

        var resultado = await ventasService.Guardar(venta);
        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess("Venta guardada correctamente");
            Navigation.NavigateTo("/Ventas");
        }
        else
        {
            toastService.ShowError(resultado.Error.Description);
        }
    } 
}
