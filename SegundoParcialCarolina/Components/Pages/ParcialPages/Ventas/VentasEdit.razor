@page "/Ventas/Editar/{VentaId:int}"
@rendermode InteractiveServer
@inject VentasService ventasService
@inject NavigationManager Navigation
@inject ToastService toastService

<EditForm Model="venta" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5 class="card-title">Editar Venta</h5>
            </div>

            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="venta.Fecha" />
                    <ValidationMessage For="() => venta.Fecha" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Observación</label>
                    <InputText class="form-control" @bind-Value="venta.Observacion" />
                </div>

                <ProductoPicker Productos="productos" OnProductoSelected="Agregar" />

                <QuickGrid Items="venta.Detalles.AsQueryable()" Class="table table-hover mt-3">

                    <TemplateColumn Title="Producto" Context="detalle">
                        @productos.FirstOrDefault(p => p.ProductoId == detalle.ProductoId)?.Nombre
                    </TemplateColumn>

                    <PropertyColumn Property="d => d.Cantidad" Title="Cantidad" />

                    <PropertyColumn Property="d => d.Precio" Title="Precio" Format="N2" />

                    <TemplateColumn Title="SubTotal" Context="detalle">
                        @((detalle.Cantidad * detalle.Precio).ToString("N2"))
                    </TemplateColumn>

                    <TemplateColumn Title="Opciones" Context="detalle">
                        <button type="button" class="btn btn-outline-danger bi bi-trash" @onclick="() => Quitar(detalle)"> </button>
                    </TemplateColumn>

                </QuickGrid>

                <p class="text-end fw-bold">
                    Total:@venta.Detalles.Sum(d => d.Cantidad * d.Precio).ToString("N2")
                </p>

            </div>

            <div class="card-footer text-center">
                <a href="/Ventas" class="btn btn-secondary"> Volver </a>

                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal"  data-bs-target="#modalEliminar"> Eliminar</button>

                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar </button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <p>¿Eliminar esta venta?</p>
                <p>Fecha: @venta.Fecha.ToShortDateString()</p>
                <p>Observación: @venta.Observacion</p>
                <p>
                    Total:
                    @venta.Detalles.Sum(d =>
                        d.Cantidad * d.Precio).ToString("N2")
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal"
                        @onclick="Eliminar">
                    Eliminar
                </button>
            </div>

        </div>
    </div>
</div>


@code {
    [Parameter]
    public int VentaId { get; set; }

    private Ventas venta = new();
    private List<Productos> productos = new();
    private bool cargando = true;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;

        productos = await ventasService.ListarProductos();

        var resultado = await ventasService.Buscar(VentaId);

        if (resultado.IsSuccess && resultado.Value != null)
        {
            venta = resultado.Value;
        }
        else
        {
            toastService.ShowError("Venta no encontrada");
            Navigation.NavigateTo("/Ventas");
        }

        cargando = false;
    }

    private void Agregar((Productos producto, int cantidad) item)
    {
        if (item.cantidad <= 0)
        {
            toastService.ShowError(
                "La cantidad debe ser mayor que cero");
            return;
        }

        venta.Detalles.Add(new VentasDetalle
        {
            ProductoId = item.producto.ProductoId,
            Cantidad = item.cantidad,
            Precio = item.producto.Precio
        });
    }

    private void Quitar(VentasDetalle detalle)
    {
        venta.Detalles.Remove(detalle);
    }

    private async Task Modificar()
    {
        if (!venta.Detalles.Any())
        {
            toastService.ShowError(
                "Debe agregar al menos un producto");
            return;
        }

        var resultado = await ventasService.Guardar(venta);

        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess(
                "Venta modificada correctamente");

            Navigation.NavigateTo("/Ventas");
        }
        else
        {
            toastService.ShowError(
                resultado.Error.Description);
        }
    }

    private async Task Eliminar()
    {
        var resultado = await ventasService.Eliminar(VentaId);

        if (resultado.IsSuccess)
        {
            toastService.ShowSuccess(
                "Venta eliminada correctamente");

            Navigation.NavigateTo("/Ventas");
        }
        else
        {
            toastService.ShowError(
                resultado.Error.Description);
        }
    }
}
